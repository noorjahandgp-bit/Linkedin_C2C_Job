# ========================================================
# JobPilot AI — Environment & Credential Configuration
# ========================================================

# 1. Candidate Details (Used for C2C Applications & Search Query)
CANDIDATE_NAME=Alex Morgan
CANDIDATE_EMAIL=alex.morgan@email.com
CANDIDATE_PHONE=+1 (555) 123-4567
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/alexmorgan
CANDIDATE_LOCATION=Dallas, TX
CANDIDATE_WORK_AUTH=US Citizen
CANDIDATE_AVAILABILITY=Immediate / 2 weeks
CANDIDATE_TOTAL_EXP=8+ Years
CANDIDATE_EXPECTED_RATE=$75 - $85/hr (Negotiable)
CANDIDATE_DEFAULT_TITLE=Java Developer

# 2. LinkedIn Credentials & Session
# You can provide username/password or run: python run_automation.py --record-session
LINKEDIN_USERNAME=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
LINKEDIN_HEADLESS=true

# 3. AI API Keys (Optional - Local truthful ATS optimizer used if keys are absent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# 4. Gmail Configuration (For automated dispatch)
# Use a Google App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
